# EKSPERIMEN: ReSukiSU v3.3.0 (commit 08a3b087)
# Jangan dipakai bersamaan dengan config.env aman.
# Cara pakai: Run workflow dengan input config=config-v330.env
# dan scripts/patches.sh diganti scripts-v330-patches.sh.

SOURCE_BOOT_IMAGE=https://github.com/asyhariamsa/KernelSU_Action/releases/download/boot-source/boot.img

EXTRA_DEFCONFIG=CONFIG_CPU_FREQ_GOV_PERFORMANCE=y CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n CONFIG_MQ_IOSCHED_KYBER=y CONFIG_DEFAULT_IOSCHED="kyber" CONFIG_UBSAN=n CONFIG_UBSAN_TRAP=n CONFIG_DEBUG_INFO=n CONFIG_SCHED_DEBUG=n CONFIG_STACKPROTECTOR=n CONFIG_EXT4_FS=y

CONFIG_ENV=config-v330.env

# ---------------------------- Kernel source -----------------------
KERNEL_SOURCE=https://github.com/dereference23/kernel_xiaomi_sm6375
KERNEL_SOURCE_BRANCH=20260613
KERNEL_CONFIG=veux_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=chrollo-v330
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------- Toolchain ---------------------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------- KernelSU ----------------------------
# v3.3.0 tapi source kernel punya hook lama, jadi hook lama dibongkar
# oleh scripts-v330-patches.sh dan KSU memakai kprobes.
KSU_VARIANT=resukisu
KSU_REF=08a3b087e49227c8a6731c5f1114998b5e25255b
KSU_HOOK_MODE=kprobes
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_PATH_UMOUNT=true

# ---------------------------- SUSFS / hiding ----------------------
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ---------------------------- Kconfig -----------------------------
# v3.3.0 Kconfig: config KSU depends on KPROBES && EXT4_FS
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=false

# ---------------------------- Packaging ---------------------------
NEED_DTBO=false
BUILD_BOOT_IMG=true

# ---------------------------- Runner ------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
