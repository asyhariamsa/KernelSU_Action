# Source Voltage branch 17 + backslashxx KernelSU.
# PERBAIKAN ERROR: DISABLE_LTO dimatikan (dulu true) karena Tanpa LTO,
# linker kernel gagal di arch/arm64/kernel/vmlinux.lds.S:
#   ASSERT(SIZEOF(.plt) == 0, "Unexpected run-time procedure linkages detected!")
# Voltage veux_defconfig sudah LTO_CLANG=y + THINLTO=n (full LTO, sama seperti
# kernel teman). Jangan pernah set DISABLE_LTO=true untuk KSU built-in.

SOURCE_BOOT_IMAGE=https://github.com/asyhariamsa/KernelSU_Action/releases/download/boot-source/boot.img

# Tweaks kita: schedutil, kyber, HZ 250, tanpa debug info.
# CONFIG_STACKPROTECTOR=n DIHAPUS (kernel teman pakai stack protector ON).
EXTRA_DEFCONFIG=CONFIG_CPU_FREQ_GOV_PERFORMANCE=y CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n CONFIG_MQ_IOSCHED_KYBER=y CONFIG_DEFAULT_IOSCHED="kyber" CONFIG_UBSAN=n CONFIG_UBSAN_TRAP=n CONFIG_DEBUG_INFO=n CONFIG_SCHED_DEBUG=n CONFIG_HZ_250=y CONFIG_HZ_100=n CONFIG_EXT4_FS=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_SCHED_CASS=n

CONFIG_ENV=config.env

# ---------------------------- Kernel source -----------------------
KERNEL_SOURCE=https://github.com/VoltageOS-Devices/kernel_xiaomi_sm6375
KERNEL_SOURCE_BRANCH=17
KERNEL_CONFIG=veux_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=chrollo-v1
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------- Toolchain ---------------------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------- KernelSU ----------------------------
KSU_VARIANT=backslashxx
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_PATH_UMOUNT=false

# ---------------------------- SUSFS / hiding ----------------------
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ---------------------------- Kconfig -----------------------------
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# ---------------------------- Packaging ---------------------------
NEED_DTBO=false
BUILD_BOOT_IMG=true

# ---------------------------- Runner ------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
