
SOURCE_BOOT_IMAGE=https://github.com/asyhariamsa/KernelSU_Action/releases/download/boot-source/boot.img


EXTRA_DEFCONFIG=CONFIG_CPU_FREQ_GOV_PERFORMANCE=y CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n CONFIG_MQ_IOSCHED_KYBER=y CONFIG_DEFAULT_IOSCHED="kyber" CONFIG_UBSAN=n CONFIG_UBSAN_TRAP=n CONFIG_DEBUG_INFO=n CONFIG_SCHED_DEBUG=n CONFIG_STACKPROTECTOR=n
# ================================================================

CONFIG_ENV=config.env

# ---------------------------- Kernel source -----------------------
KERNEL_SOURCE=https://github.com/dereference23/kernel_xiaomi_sm6375
KERNEL_SOURCE_BRANCH=20260613
KERNEL_CONFIG=veux_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=chrollo-ksu
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------- Toolchain ---------------------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------- KernelSU ----------------------------
# Source kernel ini sudah punya hook API KernelSU 0.9.x lama
# (ksu_vfs_read_hook, ksu_execveat_hook, ksu_input_hook).
# BakaSU/ReSukiSU v4 pakai API baru, jadi tidak cocok.
# Pakai KernelSU upstream v0.9.5 (pilihan otomatis untuk kernel <5.10).
KSU_VARIANT=kernelsu
KSU_REF=
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_PATH_UMOUNT=true

# ---------------------------- SUSFS / hiding ----------------------
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ---------------------------- Kconfig -----------------------------
# KernelSU v0.9.5 manual hook: KPROBES harus MATI.
# Kalau KPROBES=y, ksu_vfs_read_hook/execveat_hook/input_hook tidak didefinisikan.
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
# Clang r450784e memicu bug __stack_chk_guard. Matikan LTO + stack protector.
DISABLE_LTO=true
DISABLE_CC_WERROR=false

# ---------------------------- Packaging ---------------------------
# DTB sudah ikut di boot.img (BOARD_INCLUDE_DTB_IN_BOOTIMG := true).
NEED_DTBO=false
BUILD_BOOT_IMG=true

# ---------------------------- Runner ------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
