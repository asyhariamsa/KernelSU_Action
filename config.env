# EKSPERIMEN HARDENING (BELUM TERUJI).
# Stack protector global (PER_TASK=n) -> __stack_chk_guard terdefinisi,
# seharusnya link sukses di Voltage 5.4 + clang 14 + full LTO.
# Kalau link gagal lagi "undefined symbol: __stack_chk_guard", turunkan
# CONFIG_STACKPROTECTOR_STRONG=n (biarkan STACKPROTECTOR=y, PER_TASK=n).
# KSU_DEBUG sudah dimatikan.
# PERINGATAN: build + flash + tes video call dulu sebelum dipakai harian.
# Source Voltage branch 17 + backslashxx KernelSU.
# PERBAIKAN ERROR: DISABLE_LTO dimatikan (dulu true) karena Tanpa LTO,
# linker kernel gagal di arch/arm64/kernel/vmlinux.lds.S:
#   ASSERT(SIZEOF(.plt) == 0, "Unexpected run-time procedure linkages detected!")
# Voltage veux_defconfig sudah LTO_CLANG=y + THINLTO=n (full LTO, sama seperti
# kernel teman). Jangan pernah set DISABLE_LTO=true untuk KSU built-in.

SOURCE_BOOT_IMAGE=https://github.com/asyhariamsa/KernelSU_Action/releases/download/boot-source/boot.img

# Tweaks kita: schedutil, kyber, HZ 250, tanpa debug info.
# WAJIB: stack protector dimatikan. Di tree Voltage + clang 14 + LTO,
# CONFIG_STACKPROTECTOR_PER_TASK tidak mendefinisikan __stack_chk_guard,
# sehingga link gagal "undefined symbol: __stack_chk_guard" dan lld
# membuat GOT/PLT -> ASSERT linker script menyala.
#
# KSU HOOK: dengan KSU built-in (KSU=y), Kconfig backslashxx mematikan
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK secara default (default-nya cuma y
# kalau KSU=m). Akibatnya tidak ada hook execve sama sekali:
#   - preinit tidak pernah menjalankan ksud  -> ksud tidak start
#   - throne tracker tidak pernah jalan      -> manager tidak "crowned"
#   - is_manager() false                     -> ioctl GRANT_ROOT ditolak
#     ("Failed to grant Root!") dan `su` tidak berfungsi.
# Branch-link hook sekaligus mengaktifkan syscall-table hook sebagai
# fallback, jadi execve/faccessat/stat selalu ter-hook di 5.4.
EXTRA_DEFCONFIG=CONFIG_STACKPROTECTOR=y CONFIG_STACKPROTECTOR_STRONG=y CONFIG_STACKPROTECTOR_PER_TASK=n CONFIG_CPU_FREQ_GOV_PERFORMANCE=y CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n CONFIG_MQ_IOSCHED_KYBER=y CONFIG_DEFAULT_IOSCHED="kyber" CONFIG_UBSAN=n CONFIG_UBSAN_TRAP=n CONFIG_DEBUG_INFO=n CONFIG_SCHED_DEBUG=n CONFIG_HZ_250=y CONFIG_HZ_100=n CONFIG_EXT4_FS=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_SCHED_CASS=n CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y CONFIG_KSU_TAMPER_SYSCALL_TABLE=n CONFIG_KSU_LSM_SECURITY_HOOKS=y CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y CONFIG_KSU_DEBUG=n

CONFIG_ENV=config.env

# ---------------------------- Kernel source -----------------------
KERNEL_SOURCE=https://github.com/VoltageOS-Devices/kernel_xiaomi_sm6375
KERNEL_SOURCE_BRANCH=17
KERNEL_CONFIG=veux_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=chrollo-v1
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------- Toolchain ---------------------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------- KernelSU ----------------------------
KSU_VARIANT=backslashxx
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_PATH_UMOUNT=true

# ---------------------------- SUSFS / hiding ----------------------
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ---------------------------- Kconfig -----------------------------
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# ---------------------------- Packaging ---------------------------
NEED_DTBO=false
BUILD_BOOT_IMG=true

# ---------------------------- Runner ------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
